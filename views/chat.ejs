<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Chats • PINSTA</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/socket.io/socket.io.js"></script>
    <style>
        /* Chat Layout fix taaki sirf beech ka hissa scroll ho */
        .chat-container {
            display: flex;
            height: calc(100vh - 60px);
            background: #000;
            color: #fff;
        }
        .chat-sidebar {
            width: 35%;
            border-right: 1px solid #262626;
            overflow-y: auto;
        }
        .chat-main {
            width: 65%;
            display: flex;
            flex-direction: column;
            height: 100%;
            background: #000;
        }
        .chat-box-header {
            padding: 15px;
            border-bottom: 1px solid #262626;
            background: #000;
        }
        .messages-box {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .chat-input-form {
            padding: 15px;
            border-top: 1px solid #262626;
            background: #000;
            display: flex;
            gap: 10px;
        }
        .chat-input-form input {
            flex: 1;
            padding: 10px;
            background: #121212;
            border: 1px solid #262626;
            color: #fff;
            border-radius: 5px;
        }
        .chat-input-form button {
            padding: 10px 20px;
            background: #0095f6;
            color: #fff;
            border: none;
            border-radius: 5px;
            font-weight: bold;
        }
        .user-chat-item {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            text-decoration: none;
            color: #fff;
            border-bottom: 1px solid #1a1a1a;
        }
        .user-chat-item:hover, .user-chat-item.active {
            background: #121212;
        }
        .msg {
            padding: 10px 14px;
            border-radius: 15px;
            max-width: 60%;
            word-break: break-word;
            font-size: 14px;
        }
        .msg.sent {
            background: #0095f6;
            color: #fff;
            align-self: flex-end;
        }
        .msg.received {
            background: #262626;
            color: #fff;
            align-self: flex-start;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <h2>PINSTA</h2>
        <a href="/logout" style="color: #ed4956; text-decoration: none; font-size: 13px; font-weight: 600;">Logout</a>
    </nav>

    <div class="chat-container">
        <!-- Sidebar - Users List -->
        <div class="chat-sidebar">
            <div style="padding: 15px; font-weight: bold; border-bottom: 1px solid #262626;">Messages</div>
            <% chatUsers.forEach(u => { %>
                <a href="/chat/<%= u.username %>" class="user-chat-item <%= activeUser && activeUser.username === u.username ? 'active' : '' %>">
                    <b>@<%= u.username %></b>
                </a>
            <% }) %>
        </div>

        <!-- Main Chat Area -->
        <div class="chat-main">
            <% if (activeUser) { %>
                <div class="chat-box-header">
                    <b>@<%= activeUser.username %></b>
                </div>
                
                <!-- Yeh wala part scroll hoga -->
                <div class="messages-box" id="messagesBox">
                    <% messages.forEach(m => { %>
                        <div class="msg <%= m.sender === loggedInUser.username ? 'sent' : 'received' %>">
                            <%= m.text %>
                        </div>
                    <% }) %>
                </div>

                <!-- Input box fix rahega -->
                <form id="chatForm" class="chat-input-form">
                    <input type="text" id="msgInput" placeholder="Message..." required autocomplete="off">
                    <button type="submit">Send</button>
                </form>
            <% } else { %>
                <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #8e8e8e;">
                    Select a chat to start messaging
                </div>
            <% } %>
        </div>
    </div>

    <div class="bottom-nav">
        <a href="/feed" class="nav-item">🏠</a>
        <button class="nav-item" onclick="openSearch()">🔍</button>
        <button class="nav-item" onclick="openModal()">➕</button>
        <a href="/chat" class="nav-item active">💬</a>
        <a href="/profile/<%= loggedInUser.username %>" class="nav-item">👤</a>
    </div>

    <!-- Modals for Search & Post -->
    <div id="postModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal()">&times;</span>
            <h3 style="margin-bottom: 15px; font-size: 18px;">Create New Post</h3>
            <form action="/post" method="POST" enctype="multipart/form-data">
                <input type="file" name="image" accept="image/*" required style="margin-bottom: 12px; color: #fff;">
                <input type="text" name="content" placeholder="Write a caption..." required>
                <button type="submit">Share Post</button>
            </form>
        </div>
    </div>

    <div id="searchModal" class="search-modal">
        <div class="search-header">
            <input type="text" id="searchInput" placeholder="Search username..." onkeyup="performSearch()">
            <button onclick="closeSearch()" style="background:none; border:none; color:#fff; font-size:16px;">Cancel</button>
        </div>
        <div id="searchResults" class="search-results-list"></div>
    </div>

    <script>
        function openModal() { document.getElementById('postModal').style.display = 'flex'; }
        function closeModal() { document.getElementById('postModal').style.display = 'none'; }
        function openSearch() { document.getElementById('searchModal').style.display = 'flex'; document.getElementById('searchInput').focus(); }
        function closeSearch() { document.getElementById('searchModal').style.display = 'none'; }

        function performSearch() {
            let query = document.getElementById('searchInput').value;
            if(query.trim() === '') { document.getElementById('searchResults').innerHTML = ''; return; }
            fetch('/search?q=' + query).then(res => res.json()).then(users => {
                let html = '';
                users.forEach(u => { html += `<a href="/profile/${u.username}" class="user-search-item"><b>@${u.username}</b></a>`; });
                document.getElementById('searchResults').innerHTML = html;
            });
        }

        const msgBox = document.getElementById('messagesBox');
        if(msgBox) { msgBox.scrollTop = msgBox.scrollHeight; }

        <% if (activeUser) { %>
            const socket = io();
            const loggedInUser = "<%= loggedInUser.username %>";
            const activeUsername = "<%= activeUser.username %>";

            socket.emit('joinRoom', { sender: loggedInUser, receiver: activeUsername });

            const form = document.getElementById('chatForm');
            const input = document.getElementById('msgInput');

            form.addEventListener('submit', function(e) {
                e.preventDefault();
                if (input.value) {
                    socket.emit('privateMessage', { sender: loggedInUser, receiver: activeUsername, text: input.value });
                    input.value = '';
                }
            });

            socket.on('privateMessage', function(msg) {
                const div = document.createElement('div');
                div.className = 'msg ' + (msg.sender === loggedInUser ? 'sent' : 'received');
                div.textContent = msg.text;
                msgBox.appendChild(div);
                msgBox.scrollTop = msgBox.scrollHeight;
            });
        <% } %>
    </script>
</body>
</html>
